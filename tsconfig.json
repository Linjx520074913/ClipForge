{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "preserve",
        "types": ["node"],

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "baseUrl": ".",
        "paths":{
            "@api/*":            ["src/api/*"],
            "@assets/*":         ["src/assets/*"],
            "@avcore/*":         ["src/module/avcore/*"],
            "@src/components/*": ["src/components/*"],
            "@router/*":         ["src/router/*"],
            "@store/*":          ["src/store/*"],
            "@src/page/*":       ["src/page/*"],
            "@src-shared/*":     ["../src-shared/*"],
        }
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "src/assets/data/mock-router-graph.json"],
    "references": [{ "path": "./tsconfig.node.json" }]
}
