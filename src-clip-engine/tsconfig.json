{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",                   // ✅ 必须匹配 moduleResolution
    "moduleResolution": "NodeNext",         // ✅ 必须匹配 module
    "lib": ["DOM", "ES2022"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": ["core", "global.d.ts", "test"]
}
